<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inbound Review Queue — unmatched customer email (PHASE 3) -->
    <record id="premafirm_inbound_queue_tree" model="ir.ui.view">
        <field name="name">premafirm.inbound.queue.tree</field>
        <field name="model">premafirm.inbound.queue</field>
        <field name="arch" type="xml">
            <list string="Inbound Review Queue" editable="bottom">
                <field name="id" readonly="1"/>
                <field name="create_date" readonly="1"/>
                <field name="email_from"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="classification"/>
                <field name="thread_candidate_id"/>
                <field name="mailbox"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="premafirm_inbound_queue_form" model="ir.ui.view">
        <field name="name">premafirm.inbound.queue.form</field>
        <field name="model">premafirm.inbound.queue</field>
        <field name="arch" type="xml">
            <form string="Inbound Review Queue">
                <header>
                    <button name="action_thread_to_lead" type="object"
                            string="Thread to Lead" class="btn-primary"
                            invisible="state in ('threaded', 'ignored', 'lead_created')"/>
                    <button name="action_create_lead" type="object"
                            string="Create Lead" class="btn-secondary"
                            invisible="state in ('threaded', 'ignored', 'lead_created')"/>
                    <button name="action_mark_reviewed" type="object"
                            string="Mark Reviewed" class="btn-secondary"
                            invisible="state in ('reviewed', 'threaded', 'ignored', 'lead_created')"/>
                    <button name="action_mark_ignored" type="object"
                            string="Ignore" class="btn-secondary"
                            invisible="state in ('threaded', 'ignored', 'lead_created')"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="state"/>
                            <field name="classification"/>
                            <field name="create_date" readonly="1"/>
                            <field name="email_from"/>
                            <field name="partner_id"/>
                            <field name="mailbox"/>
                        </group>
                        <group>
                            <field name="name" string="Subject"/>
                            <field name="message_id" readonly="1"/>
                            <field name="thread_candidate_id"
                                   help="Best guess only — verify before threading."/>
                            <field name="review_note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Body" name="body">
                            <field name="body" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="premafirm_inbound_queue_action" model="ir.actions.act_window">
        <field name="name">Inbound Review Queue</field>
        <field name="res_model">premafirm.inbound.queue</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'ignored')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No unmatched customer emails waiting for review.
            </p>
            <p>
                Emails that look like replies to PremaFirm threads but lost
                their threading headers land here instead of becoming new
                leads. Review, then thread them to the right lead, create a
                lead if it is a genuine new inquiry, or ignore.
            </p>
        </field>
    </record>

    <menuitem id="menu_premafirm_inbound_queue" name="Inbound Review Queue"
              parent="crm.crm_menu_root" sequence="80"
              action="premafirm_inbound_queue_action"/>
</odoo>
