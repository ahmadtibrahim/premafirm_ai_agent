<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ── Full-page view (standalone "Find Prospects" menu entry) ── -->
    <record id="view_snov_search_wizard_form_fullpage" model="ir.ui.view">
        <field name="name">snov.search.wizard.form.fullpage</field>
        <field name="model">snov.search.wizard</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form string="Find Prospects via Snov.io">

                <!-- ── SEARCH PANEL ── -->
                <group invisible="state != 'search'">
                    <group string="Company to Search">
                        <field name="domain"
                               placeholder="e.g. loblaw.com, ippolito.com, uline.com"
                               autofocus="autofocus"/>
                        <field name="limit" string="Max Results (up to 100)"/>
                    </group>
                    <group string="Job Title Filter (optional)">
                        <field name="positions" nolabel="1"
                               placeholder="e.g. Logistics Manager, VP Supply Chain — blank = return all titles"/>
                        <button name="action_use_all_titles" type="object"
                                string="Load All Freight-Relevant Titles"
                                class="btn-sm btn-secondary"/>
                        <field name="suggested_titles" invisible="1"/>
                    </group>
                    <group string="Link to Existing Lead (optional)">
                        <field name="lead_id" nolabel="1"
                               placeholder="Leave blank to create new CRM leads on import"/>
                    </group>
                </group>

                <!-- ── RESULTS PANEL ── -->
                <group invisible="state != 'results'">
                    <div class="alert alert-danger" role="alert" invisible="not error_msg">
                        <field name="error_msg" readonly="1" nolabel="1"/>
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-2" invisible="not result_ids">
                        <strong><field name="result_count" readonly="1" nolabel="1"/> contacts found</strong>
                        <span class="text-muted ms-2">(<field name="selected_count" readonly="1" nolabel="1"/> selected)</span>
                        <button name="action_select_all" type="object"
                                string="Select All" class="btn-sm btn-secondary ms-3"/>
                        <button name="action_deselect_all" type="object"
                                string="Deselect All" class="btn-sm btn-secondary"/>
                    </div>

                    <field name="result_ids" nolabel="1" invisible="not result_ids">
                        <list editable="top" decoration-muted="confidence &lt; 40">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="display_name_computed" string="Name" readonly="1"/>
                            <field name="title" string="Job Title" readonly="1"/>
                            <field name="company_name" string="Company" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="city" readonly="1" optional="show"/>
                            <field name="country" readonly="1"/>
                            <field name="confidence" string="Confidence %" readonly="1"
                                   widget="progressbar"
                                   options="{'editable': false, 'max_value': 100}"/>
                            <field name="linkedin_url" widget="url" readonly="1" optional="show"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <!-- Search state -->
                    <button name="action_search" type="object"
                            string="Search Snov.io" class="btn-primary"
                            invisible="state != 'search'"/>
                    <button special="cancel" string="Close" class="btn-secondary"
                            invisible="state != 'search'"/>

                    <!-- Results state — create new leads (no lead_id set) -->
                    <button name="action_create_leads" type="object"
                            string="Create CRM Leads from Selected" class="btn-primary"
                            invisible="state != 'results' or lead_id != False"/>

                    <!-- Results state — add to existing lead (lead_id set) -->
                    <button name="action_import_to_lead" type="object"
                            string="Add Selected to Lead" class="btn-primary"
                            invisible="state != 'results' or not lead_id"/>

                    <button name="action_back" type="object"
                            string="&#8592; New Search" class="btn-secondary"
                            invisible="state != 'results'"/>
                    <button special="cancel" string="Close" class="btn-secondary"
                            invisible="state != 'results'"/>
                </footer>
            </form>
        </field>
    </record>


</odoo>
