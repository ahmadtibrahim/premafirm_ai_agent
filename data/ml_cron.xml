<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- Nightly: suggest tags for untagged contacts (batch of 20) -->
    <record id="cron_ml_tag_partners" model="ir.cron">
        <field name="name">ML: Auto-tag Untagged Contacts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.action_ml_batch_tag_partners()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Nightly: incremental ingest of new Odoo records into knowledge base -->
    <record id="cron_ml_incremental_ingest" model="ir.cron">
        <field name="name">ML: Nightly Incremental Ingest</field>
        <field name="model_id" ref="model_premafirm_ml_ingestion"/>
        <field name="state">code</field>
        <field name="code">model.action_cron_incremental_ingest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
