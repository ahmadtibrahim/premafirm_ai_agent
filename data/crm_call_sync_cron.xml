<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- PHASE 25 — VoIP.ms CDR sync cron. Ships DISABLED (same posture as
         the follow-up crons): it only activates when the operator enables
         it at deployment, so no production automation is touched during
         development. The pull itself is read-only against VoIP.ms. -->
    <data noupdate="1">

        <record id="ir_cron_voipms_cdr_sync" model="ir.cron">
            <field name="name">CRM: VoIP.ms CDR Sync</field>
            <field name="model_id" ref="voipms_sms.model_voipms_call_log"/>
            <field name="state">code</field>
            <field name="code">model.fetch_from_voipms(days=2)</field>
            <field name="interval_number">60</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
            <field name="nextcall">2026-08-19 07:00:00</field>
        </record>

    </data>
</odoo>
