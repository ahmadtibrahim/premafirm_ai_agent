<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_apollo_search_wizard_form" model="ir.ui.view">
        <field name="name">apollo.search.wizard.form</field>
        <field name="model">apollo.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Search Apollo Contacts">

                <!-- Search panel -->
                <group invisible="state != 'search'">
                    <group string="Search Filters">
                        <field name="lead_id" invisible="1"/>
                        <field name="suggested_titles" invisible="1"/>
                        <field name="company_name" placeholder="e.g. Ippolito Fruit, Loblaws"/>
                        <field name="job_titles"
                               placeholder="e.g. Logistics Manager, Supply Chain Director"/>
                        <div class="text-muted small mb-2">
                            Carrier-relevant titles pre-filled. Edit freely or click below to load all.
                        </div>
                        <button name="action_use_all_titles" type="object"
                                string="Load All Recommended Titles"
                                class="btn-sm btn-secondary mb-2"/>
                        <field name="city" placeholder="e.g. Toronto, Brampton"/>
                        <field name="country" placeholder="e.g. Canada"/>
                        <field name="keywords" placeholder="Optional keywords"/>
                    </group>
                </group>

                <!-- Results panel -->
                <group invisible="state != 'results'">
                    <field name="error_msg" invisible="not error_msg"
                           widget="text" readonly="1" nolabel="1"
                           style="color:red"/>
                    <field name="result_count" string="Results Found" readonly="1"/>
                    <field name="result_ids" invisible="not result_ids">
                        <list editable="top">
                            <field name="selected"/>
                            <field name="display_name_computed" string="Name"/>
                            <field name="title"/>
                            <field name="company_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="city"/>
                            <field name="country"/>
                            <field name="linkedin_url" widget="url" optional="show"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <!-- Search state buttons -->
                    <button name="action_search" type="object" string="Search Apollo"
                            class="btn-primary"
                            invisible="state != 'search'"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"
                            invisible="state != 'search'"/>

                    <!-- Results state buttons -->
                    <button name="action_import_selected" type="object" string="Import Selected"
                            class="btn-primary"
                            invisible="state != 'results'"/>
                    <button name="action_back" type="object" string="Back"
                            class="btn-secondary"
                            invisible="state != 'results'"/>
                    <button special="cancel" string="Close" class="btn-secondary"
                            invisible="state != 'results'"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
