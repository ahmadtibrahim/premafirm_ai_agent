<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- PHASE 15 — the consolidated Follow-Up Service. Timing params
             (never hardcoded in code) + the ONE cron. The cron ships
             INACTIVE: operators enable it deliberately (the service can
             auto-send when crm.followup.send_mode=auto, so activation is
             an explicit decision). -->
        <record id="param_followup_outreach_followup_bizdays" model="ir.config_parameter">
            <field name="key">crm.followup.outreach_followup_bizdays</field>
            <field name="value">3</field>
        </record>
        <record id="param_followup_final_followup_bizdays" model="ir.config_parameter">
            <field name="key">crm.followup.final_followup_bizdays</field>
            <field name="value">5</field>
        </record>
        <record id="param_followup_cold_days" model="ir.config_parameter">
            <field name="key">crm.followup.cold_days</field>
            <field name="value">60</field>
        </record>
        <record id="param_followup_engaged_reply_days" model="ir.config_parameter">
            <field name="key">crm.followup.engaged_reply_days</field>
            <field name="value">3</field>
        </record>
        <record id="param_followup_stale_reply_days" model="ir.config_parameter">
            <field name="key">crm.followup.stale_reply_days</field>
            <field name="value">6</field>
        </record>
        <record id="param_followup_no_reply_review_days" model="ir.config_parameter">
            <field name="key">crm.followup.no_reply_review_days</field>
            <field name="value">7</field>
        </record>
        <record id="param_followup_send_mode" model="ir.config_parameter">
            <field name="key">crm.followup.send_mode</field>
            <field name="value">draft</field>
        </record>

        <record id="ir_cron_crm_followup_service" model="ir.cron">
            <field name="name">CRM: Consolidated Follow-Up Service</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model.run_followup_service_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
