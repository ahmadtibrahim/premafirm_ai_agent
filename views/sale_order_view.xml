<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_premafirm_ai" model="ir.ui.view">
        <field name="name">sale.order.form.premafirm.ai</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Confirmation is always an explicit internal action. -->
            <xpath expr="//header/button[@name='action_confirm']" position="attributes">
                <attribute name="string">Confirm Internally</attribute>
                <attribute name="confirm">Confirm this quotation internally and convert it to a Sales Order? Preview and customer portal approval never perform this action.</attribute>
            </xpath>

            <!-- PremaFirm load details block -->
            <xpath expr="//sheet/group" position="after">
                <group string="PremaFirm Load Details">
                    <group>
                        <field name="premafirm_po"/>
                        <field name="premafirm_bol"/>
                        <field name="premafirm_pod"/>
                        <field name="load_reference"/>
                    </group>
                    <group>
                        <field name="pickup_city"/>
                        <field name="delivery_city"/>
                    </group>
                </group>
            </xpath>

            <!-- Send for WhatsApp Approval button -->
            <xpath expr="//header/button[@name='action_confirm']" position="before">
                <button name="action_send_wa_for_approval" type="object"
                        string="Send for WA Approval"
                        class="btn-primary"
                        icon="fa-whatsapp"
                        invisible="state not in ('draft','sent')"
                        confirm="Send this quotation to the customer via WhatsApp for digital approval?"/>
            </xpath>

            <!-- AI Generate button — draft/sent quotations only -->
            <xpath expr="//header/button[@name='action_confirm']" position="before">
                <button name="action_ai_generate_quote" type="object"
                        string="AI Generate"
                        class="btn-secondary"
                        icon="fa-magic"
                        invisible="state not in ('draft','sent')"/>
            </xpath>

            <!-- AI Summary tab — appears once a summary exists or instruction is typed -->
            <xpath expr="//notebook" position="inside">
                <page string="AI Summary" name="ai_summary_quote_tab"
                      invisible="not x_ai_summary and not x_ai_summary_instruction">
                    <group>
                        <field name="x_ai_summary" widget="text" nolabel="1" readonly="1"
                               style="min-height:80px; background:#f0f4ff; border-left:3px solid #6c7dd1; padding:10px; border-radius:4px; white-space:pre-wrap;"/>
                    </group>
                    <group string="Generate or refine">
                        <field name="x_ai_summary_instruction"
                               placeholder="e.g. 'Reefer delivery Toronto→Montreal 24 pallets liftgate' or 'make it shorter'"/>
                        <div>
                            <button name="action_ai_generate_quote" type="object"
                                    string="AI Generate" class="btn btn-primary btn-sm"
                                    icon="fa-magic"
                                    invisible="state not in ('draft','sent')"/>
                            <small class="text-muted ml-2" invisible="not x_ai_summary_at">
                                Last updated: <field name="x_ai_summary_at" widget="datetime" readonly="1"/>
                            </small>
                        </div>
                    </group>
                </page>
            </xpath>

            <!-- Hidden AI summary fields -->
            <xpath expr="//sheet" position="inside">
                <field name="x_ai_summary" invisible="1"/>
                <field name="x_ai_summary_instruction" invisible="1"/>
                <field name="x_ai_summary_at" invisible="1"/>
            </xpath>

            <!-- Counter Offer button shown when renegotiation is pending -->
            <xpath expr="//header/button[@name='action_confirm']" position="before">
                <button name="action_send_counter_offer" type="object"
                        string="Counter Offer"
                        class="btn-danger"
                        invisible="x_reneg_status != 'requested'"
                        confirm="Send the updated quotation as a counter offer to the customer?"/>
            </xpath>

            <!-- Hidden field so JS can read x_reneg_status from the DOM -->
            <xpath expr="//sheet" position="inside">
                <field name="x_reneg_status" invisible="1"/>
            </xpath>

            <xpath expr="//sheet/notebook" position="before">
                <field name="x_customer_approved_at" invisible="1"/>
                <field name="x_customer_approved_by" invisible="1"/>
                <div class="alert alert-success" role="alert"
                     invisible="not x_customer_approved_at or state not in ('draft', 'sent')">
                    <strong>Customer approved this quotation.</strong>
                    It is still editable and is waiting for your internal confirmation.
                    Approved by <field name="x_customer_approved_by" readonly="1" class="oe_inline"/>
                    on <field name="x_customer_approved_at" readonly="1" class="oe_inline"/>.
                </div>
            </xpath>

            <!-- Re-Negotiation tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Re-Negotiation" id="reneg_tab_page" class="o_reneg_page">

                    <!-- Flashing red alert banner when renegotiation is pending -->
                    <div class="alert alert-danger d-flex align-items-center gap-2 o_reneg_banner"
                         invisible="x_reneg_status != 'requested'">
                        <i class="fa fa-exclamation-triangle fa-lg"/>
                        <strong>Customer has requested re-negotiation — review the details below and click Counter Offer when ready.</strong>
                    </div>

                    <!-- Info banner when counter offer already sent -->
                    <div class="alert alert-success d-flex align-items-center gap-2"
                         invisible="x_reneg_status != 'counter_sent'">
                        <i class="fa fa-check-circle fa-lg"/>
                        <span>Counter offer sent on <field name="x_reneg_counter_sent_at" readonly="1" nolabel="1" widget="datetime"/>.</span>
                    </div>

                    <group string="Negotiation Details">
                        <group>
                            <field name="x_reneg_status" string="Status"/>
                            <field name="x_reneg_proposed_price" string="Counter Offer Price"/>
                            <field name="x_reneg_validity_date" string="Offer Valid Until"/>
                        </group>
                        <group>
                            <field name="x_reneg_counter_sent_at" readonly="1" string="Counter Offer Sent"/>
                        </group>
                    </group>

                    <group string="Customer Note (what the customer said)">
                        <field name="x_reneg_customer_note" nolabel="1" widget="text"
                               placeholder="Paste or type the customer's counter-offer or message here…"/>
                    </group>

                    <group string="Internal Notes">
                        <field name="x_reneg_internal_note" nolabel="1" widget="text"
                               placeholder="Internal notes for this negotiation…"/>
                    </group>

                    <!-- Mark as Requested (when status is Normal) -->
                    <div class="mt-3" invisible="x_reneg_status != 'none'">
                        <button name="action_request_renegotiation" type="object"
                                string="Mark as Re-Negotiation Requested"
                                class="btn-warning"/>
                    </div>

                    <!-- Counter Offer button inside the tab -->
                    <div class="mt-3" invisible="x_reneg_status not in ('requested', 'counter_sent')">
                        <button name="action_send_counter_offer" type="object"
                                string="Counter Offer"
                                class="btn-danger"
                                confirm="Send the updated quotation as a counter offer to the customer?"/>
                    </div>

                </page>
            </xpath>

        </field>
    </record>
</odoo>
