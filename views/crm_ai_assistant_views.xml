<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ─── CRM Lead: AI Assistant tab ─────────────────────────────────────── -->
    <record id="view_crm_lead_ai_assistant" model="ir.ui.view">
        <field name="name">crm.lead.ai.assistant</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Add AI Assistant tab after the existing tabs -->
            <xpath expr="//notebook" position="inside">
                <page name="ai_assistant" string="AI Assistant" groups="base.group_user">

                    <!-- Chat input -->
                    <div class="alert alert-info mb-2" role="alert" style="font-size:0.88em;">
                        <strong>Account Manager AI</strong> — reads this contact's full history:
                        emails, notes, invoices, and related leads. Ask anything or just say
                        <em>"Review this account"</em> for a full strategic briefing.
                    </div>
                    <group string="Ask AI">
                        <field name="x_ai_chat_input"
                               nolabel="1"
                               widget="text"
                               style="min-height:70px"
                               placeholder="Examples:&#10;• Review this account and tell me what to do next&#10;• Draft a follow-up email referencing our last invoice&#10;• Why haven't they replied? What's the best approach?&#10;• What lanes should I pitch to this company?&#10;• Write a rate increase email — be diplomatic"/>
                    </group>
                    <div class="mb-2">
                        <button name="action_ai_chat_send" type="object"
                                string="Ask AI" class="btn-primary" icon="fa-paper-plane"
                                help="AI reads this contact's emails, notes, invoices, and all related leads before answering"/>
                    </div>

                    <!-- AI Response -->
                    <div invisible="not x_ai_chat_response"
                         style="background:#f0f4ff;border-left:3px solid #6c7dd1;padding:12px;border-radius:4px;margin-bottom:12px;white-space:pre-wrap;font-family:inherit;">
                        <field name="x_ai_chat_response" nolabel="1" readonly="1"
                               style="background:transparent;border:none;width:100%;white-space:pre-wrap;"/>
                    </div>

                    <!-- Action buttons -->
                    <div invisible="not x_ai_chat_response" class="mb-3">
                        <button name="action_ai_compose_email" type="object"
                                string="Send as Email" class="btn-primary me-2" icon="fa-envelope"
                                help="Open the email composer pre-filled with this AI draft"/>
                        <button name="action_ai_append_company" type="object"
                                string="→ Company Log" class="btn-secondary me-1" icon="fa-building"
                                help="Save this AI response as a note on the company record"/>
                        <button name="action_ai_append_contact" type="object"
                                string="→ Contact Log" class="btn-secondary me-1" icon="fa-user"
                                help="Save this AI response as a note on the contact record"/>
                        <button name="action_ai_append_lead" type="object"
                                string="→ Lead Log" class="btn-secondary" icon="fa-file-text"
                                help="Save this AI response as a note on this lead"/>
                    </div>

                    <separator string="Outreach Tracking"/>
                    <group col="4">
                        <field name="x_last_outreach_at"/>
                        <field name="x_response_status"/>
                        <field name="x_needs_attention" string="Needs Attention"
                               widget="boolean_toggle"/>
                        <field name="x_followup_1_sent_at"/>
                        <field name="x_followup_2_sent_at"/>
                        <field name="x_referred_by_partner_id" string="Referred By"/>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

    <!-- ─── Partner: Account Summary button + field ─────────────────────────── -->
    <record id="view_partner_account_summary" model="ir.ui.view">
        <field name="name">res.partner.account.summary</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Generate Summary stat button -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_generate_account_summary" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        string="Generate Summary"
                        invisible="not is_company"/>
            </xpath>

            <!-- Summary display before the first group on the sheet -->
            <xpath expr="//sheet//group[1]" position="before">
                <group invisible="not x_account_summary" string="AI Account Summary">
                    <field name="x_account_summary" nolabel="1" readonly="1" widget="text"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
