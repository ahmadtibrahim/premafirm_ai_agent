<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Generate feedback memory — admin inspection UI only (quotations
         and invoices share this engine). Kept out of the quotation/invoice
         screens; reachable by admins under Settings → AI Generate Feedback.
         Internal metadata — read-only trees, editable forms for admins to
         correct scope/type/active. -->
    <record id="premafirm_ai_feedback_tree" model="ir.ui.view">
        <field name="name">premafirm.ai.feedback.tree</field>
        <field name="model">premafirm.ai.feedback</field>
        <field name="arch" type="xml">
            <list string="AI Generate learned corrections" editable="bottom">
                <field name="customer_id" optional="hide"/>
                <field name="source_model" optional="hide"/>
                <field name="source_record_id" optional="hide"/>
                <field name="field_name"/>
                <field name="correction_type"/>
                <field name="scope"/>
                <field name="ai_value" readonly="1"/>
                <field name="user_value" readonly="1"/>
                <field name="source_document_type" optional="hide"/>
                <field name="occurrence_count"/>
                <field name="last_seen_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="premafirm_ai_feedback_form" model="ir.ui.view">
        <field name="name">premafirm.ai.feedback.form</field>
        <field name="model">premafirm.ai.feedback</field>
        <field name="arch" type="xml">
            <form string="AI Generate learned correction">
                <group>
                    <group>
                        <field name="customer_id"/>
                        <field name="scope"/>
                        <field name="field_name"/>
                        <field name="correction_type"/>
                        <field name="source_document_type"/>
                        <field name="source_model"/>
                        <field name="source_record_id"/>
                        <field name="occurrence_count"/>
                        <field name="last_seen_at"/>
                        <field name="created_by" readonly="1"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="ai_value" readonly="1" placeholder="What AI Generate wrote"/>
                        <field name="user_value" readonly="1" placeholder="What the user changed it to"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="premafirm_ai_feedback_action" model="ir.actions.act_window">
        <field name="name">AI Generate Feedback (learned corrections)</field>
        <field name="res_model">premafirm.ai.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('premafirm_ai_feedback_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('premafirm_ai_feedback_form')})]"/>
    </record>

    <record id="premafirm_ai_baseline_tree" model="ir.ui.view">
        <field name="name">premafirm.ai.baseline.tree</field>
        <field name="model">premafirm.ai.baseline</field>
        <field name="arch" type="xml">
            <list string="AI Generate baseline snapshots" create="false" delete="false">
                <field name="source_ref"/>
                <field name="partner_id"/>
                <field name="generated_at"/>
                <field name="created_by"/>
                <field name="updated_at"/>
            </list>
        </field>
    </record>

    <record id="premafirm_ai_baseline_form" model="ir.ui.view">
        <field name="name">premafirm.ai.baseline.form</field>
        <field name="model">premafirm.ai.baseline</field>
        <field name="arch" type="xml">
            <form string="AI Generate baseline snapshot">
                <group>
                    <group>
                        <field name="source_model"/>
                        <field name="source_record_id"/>
                        <field name="partner_id"/>
                        <field name="generated_at"/>
                        <field name="created_by" readonly="1"/>
                    </group>
                    <group>
                        <field name="snapshot" readonly="1" nolabel="1"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="premafirm_ai_baseline_action" model="ir.actions.act_window">
        <field name="name">AI Generate Baselines</field>
        <field name="res_model">premafirm.ai.baseline</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('premafirm_ai_baseline_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('premafirm_ai_baseline_form')})]"/>
    </record>

    <menuitem id="menu_premafirm_ai_feedback_root" name="AI Generate Feedback"
              parent="base.menu_administration" sequence="90"
              groups="base.group_system"/>
    <menuitem id="menu_premafirm_ai_feedback" name="Learned corrections"
              parent="menu_premafirm_ai_feedback_root" sequence="10"
              action="premafirm_ai_feedback_action" groups="base.group_system"/>
    <menuitem id="menu_premafirm_ai_baseline" name="Baseline snapshots"
              parent="menu_premafirm_ai_feedback_root" sequence="20"
              action="premafirm_ai_baseline_action" groups="base.group_system"/>
</odoo>
