<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- MP1 §2.7 (E-A3) — dedicated activity type for recurring-
             opportunity follow-ups. Delay is irrelevant (the engine always
             passes an explicit deadline from next_followup_date). -->
        <record id="premafirm_activity_recurring_follow_up"
                model="mail.activity.type">
            <field name="name">Recurring Follow-Up</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
        </record>

    </data>
</odoo>
