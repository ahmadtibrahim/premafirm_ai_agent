<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Fetch Emails button on CRM list views -->
    <record id="view_crm_leads_list_fetch_email" model="ir.ui.view">
        <field name="name">crm.lead.list.fetch.email</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_fetch_emails" type="object"
                            string="Fetch Emails" icon="fa-refresh"
                            display="always" class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_crm_oppor_list_fetch_email" model="ir.ui.view">
        <field name="name">crm.lead.oppor.list.fetch.email</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_fetch_emails" type="object"
                            string="Fetch Emails" icon="fa-refresh"
                            display="always" class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Fetch Emails button on CRM pipeline kanban view -->
    <record id="view_crm_pipeline_kanban_fetch_email" model="ir.ui.view">
        <field name="name">crm.lead.kanban.fetch.email</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_lead_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <header>
                    <button name="action_fetch_emails" type="object"
                            string="Fetch Emails" icon="fa-refresh"
                            display="always" class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Opportunities kanban (main desktop pipeline): PHASE 41 — wait-queue
         order, oldest meaningful activity first, newest last. Needs Attention
         stays a visual badge only (rendered in the card template below). -->
    <record id="view_crm_case_kanban_order" model="ir.ui.view">
        <field name="name">crm.lead.kanban.opportunities.order</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_order">x_meaningful_activity_at asc, create_date asc, id asc</attribute>
            </xpath>
        </field>
    </record>

    <!-- Kanban PIPELINE (crm.crm_case_kanban_view_leads, id used by the actual "Pipeline" action salespeople
         use day-to-day): needs-attention leads first (most recent reply first) + pulsing badge.
         NOTE: this used to incorrectly inherit crm.view_crm_lead_kanban, which is the separate "Leads" menu's
         kanban view, not Pipeline's, so the badge/sort silently never applied to Pipeline. Fixed 2026-07-07. -->
    <record id="view_crm_lead_kanban_attention" model="ir.ui.view">
        <field name="name">crm.lead.kanban.attention</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <!-- Declare fields for card template -->
            <xpath expr="//templates" position="before">
                <field name="x_needs_attention"/>
                <field name="x_last_outreach_at"/>
                <field name="x_reply_received_at"/>
                <field name="x_attention_reply_sort_at"/>
                <field name="x_kanban_sort_date"/>
                <field name="x_meaningful_activity_at"/>
            </xpath>
            <!-- Pulsing red badge before the card footer -->
            <xpath expr="//t[@t-name='card']/footer" position="before">
                <t t-if="record.x_needs_attention.raw_value">
                    <div class="text-danger small fw-bold mt-1 mb-1 premafirm-attention">
                        <i class="fa fa-reply me-1"/>Needs Attention
                    </div>
                </t>
            </xpath>
        </field>
    </record>

    <!-- Kanban LEADS menu (crm.view_crm_lead_kanban, id 3724): same pulsing badge, for consistency
         with leads that haven't been converted to opportunities yet. -->
    <record id="view_crm_lead_kanban_leads_menu_attention" model="ir.ui.view">
        <field name="name">crm.lead.kanban.leads.menu.attention</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_lead_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_order">x_meaningful_activity_at asc, create_date asc, id asc</attribute>
            </xpath>
            <xpath expr="//templates" position="before">
                <field name="x_needs_attention"/>
                <field name="x_reply_received_at"/>
                <field name="x_attention_reply_sort_at"/>
                <field name="x_kanban_sort_date"/>
                <field name="x_meaningful_activity_at"/>
            </xpath>
            <xpath expr="//t[@t-name='card']/footer" position="before">
                <t t-if="record.x_needs_attention.raw_value">
                    <div class="text-danger small fw-bold mt-1 mb-1 premafirm-attention">
                        <i class="fa fa-reply me-1"/>Needs Attention
                    </div>
                </t>
            </xpath>
        </field>
    </record>

    <!-- Leads list view: same wait-queue order (oldest meaningful activity first) -->
    <record id="view_crm_leads_list_outreach_order" model="ir.ui.view">
        <field name="name">crm.lead.list.outreach.order</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">x_meaningful_activity_at asc, create_date asc, id asc</attribute>
            </xpath>
        </field>
    </record>

    <!-- CRM Lead form: Google autocomplete + Fetch Emails + Email Segment badge -->
    <record id="view_crm_lead_form_premafirm_ai" model="ir.ui.view">
        <field name="name">crm.lead.form.premafirm.ai</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Company name autocomplete on the Lead contact group (type == lead) -->
            <xpath expr="//group[@name='lead_partner']//field[@name='partner_name']" position="attributes">
                <attribute name="widget">google_company</attribute>
                <attribute name="options">{"phone_field": "phone", "website_field": "website", "street_field": "street", "city_field": "city", "zip_field": "zip", "state_field": "state_id", "country_field": "country_id"}</attribute>
                <attribute name="placeholder">Company name — type to search (Google)…</attribute>
            </xpath>

            <!-- Company name autocomplete on the Extra Info tab (type == opportunity) -->
            <xpath expr="//page[@name='lead']//field[@name='partner_name']" position="attributes">
                <attribute name="widget">google_company</attribute>
                <attribute name="options">{"phone_field": "phone", "website_field": "website", "street_field": "street", "city_field": "city", "zip_field": "zip", "state_field": "state_id", "country_field": "country_id"}</attribute>
                <attribute name="placeholder">Company name — type to search (Google)…</attribute>
            </xpath>

            <!-- Fetch Emails + AI Reply buttons in form header
                 (Email Segment badge removed 2026-08-20 — default sender only) -->
            <xpath expr="//header" position="inside">
                <button name="action_open_ai_reply_wizard" type="object"
                        string="AI Reply" class="btn-primary"
                        icon="fa-magic"
                        title="Tell the AI what you want to say — it drafts a professional reply from the full thread"/>
                <button name="action_reply_last_email" type="object"
                        string="Reply" class="btn-secondary"
                        icon="fa-reply"
                        title="Open the compose window threaded to the last incoming email"/>
                <button name="action_fetch_emails" type="object"
                        string="Fetch Emails" class="btn-secondary"
                        icon="fa-refresh"/>
            </xpath>

            <!-- Needs Attention banner: visible while unresolved, NOT
                 cleared by opening the lead (clear-on-open removed
                 2026-08-22 — only a real response/review resolves it). -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger premafirm-attention"
                     invisible="x_needs_attention == False"
                     style="margin: 8px 12px 0;">
                    <field name="x_needs_attention" invisible="1"/>
                    <i class="fa fa-exclamation-circle me-2"/>
                    <span><b>Customer Reply — Needs Response</b> —
                        this lead stays flagged until a reply is sent or it
                        is explicitly marked reviewed.</span>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
