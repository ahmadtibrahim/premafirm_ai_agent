<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Notes Rewrite Wizard -->
    <record id="view_notes_rewrite_wizard_form" model="ir.ui.view">
        <field name="name">premafirm.notes.rewrite.wizard.form</field>
        <field name="model">premafirm.notes.rewrite.wizard</field>
        <field name="arch" type="xml">
            <form string="Rewrite Notes (AI)">
                <sheet>
                    <group>
                        <field name="estimator_id" readonly="1" invisible="1"/>
                        <field name="status" readonly="1"/>
                        <field name="error_message" readonly="1" invisible="status != 'error'"/>
                    </group>
                    <group string="Current Notes" invisible="not current_notes">
                        <field name="current_notes" nolabel="1" readonly="1"/>
                    </group>
                    <group string="AI Suggestion" invisible="not ai_suggestion">
                        <field name="ai_suggestion" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_analyze" string="Analyze with AI" type="object"
                            class="btn-primary" invisible="status != 'pending'"/>
                    <button name="action_accept" string="Accept &amp; Apply" type="object"
                            class="btn-primary" invisible="status != 'ready'"/>
                    <button name="action_reject" string="Keep Original" type="object"
                            class="btn-secondary" invisible="status == 'pending'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            invisible="status != 'pending'"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Stops Review Wizard -->
    <record id="view_stops_review_wizard_form" model="ir.ui.view">
        <field name="name">premafirm.stops.review.wizard.form</field>
        <field name="model">premafirm.stops.review.wizard</field>
        <field name="arch" type="xml">
            <form string="AI Review Stops">
                <sheet>
                    <group>
                        <field name="estimator_id" readonly="1" invisible="1"/>
                        <field name="status" readonly="1"/>
                        <field name="error_message" readonly="1" invisible="status != 'error'"/>
                    </group>
                    <group string="AI Suggestions" invisible="not suggestions">
                        <field name="suggestions" nolabel="1" readonly="1"/>
                    </group>
                    <notebook invisible="status != 'ready'">
                        <page string="Current Stops (BEFORE)">
                            <field name="before_json" nolabel="1" readonly="1"
                                   widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="AI Suggested Stops (AFTER)">
                            <field name="after_json" nolabel="1" readonly="1"
                                   widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_analyze" string="Analyze Stops with AI" type="object"
                            class="btn-primary" invisible="status != 'pending'"/>
                    <button name="action_apply" string="Apply Changes" type="object"
                            class="btn-primary" invisible="status != 'ready'"/>
                    <button name="action_reject" string="Keep Original" type="object"
                            class="btn-secondary" invisible="status == 'pending'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            invisible="status != 'pending'"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
