<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Driver / Geotab Link Wizard -->
    <record id="view_contact_geotab_link_wizard_form" model="ir.ui.view">
        <field name="name">contact.geotab.link.wizard.form</field>
        <field name="model">contact.geotab.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Driver to Geotab Profile">
                <div class="alert alert-info" role="alert">
                    <strong>Select the Geotab driver profile</strong> to link to
                    <strong><field name="contact_id" readonly="1" nolabel="1"/></strong>.
                    Click <em>Refresh from Geotab</em> to load the latest driver list.
                </div>

                <group>
                    <group string="Geotab Driver Profile">
                        <field name="geotab_driver_id"
                               options="{'no_create': True, 'no_quick_create': True}"
                               domain="['|', ('linked_contact_id', '=', False), ('linked_contact_id', '=', contact_id)]"
                               placeholder="— Select a Geotab driver —"/>
                        <field name="driver_email" invisible="not geotab_driver_id"/>
                        <field name="driver_employee_no" invisible="not geotab_driver_id"/>
                    </group>
                    <group string="Cache Status">
                        <field name="driver_count" string="Available Drivers"/>
                        <field name="last_fetched" string="Cache Last Updated" readonly="1"/>
                    </group>
                </group>

                <footer>
                    <button name="action_refresh_drivers"
                            string="Refresh from Geotab"
                            type="object"
                            class="btn btn-secondary"
                            icon="fa-refresh"/>
                    <button name="action_link_and_import"
                            string="Link and Import Data"
                            type="object"
                            class="btn btn-primary"
                            invisible="not geotab_driver_id"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Geotab Driver Registry — list view -->
    <record id="view_premafirm_geotab_driver_list" model="ir.ui.view">
        <field name="name">premafirm.geotab.driver.list</field>
        <field name="model">premafirm.geotab.driver</field>
        <field name="arch" type="xml">
            <list string="Geotab Drivers">
                <field name="name"/>
                <field name="geotab_id"/>
                <field name="email"/>
                <field name="employee_number"/>
                <field name="linked_contact_id"/>
                <field name="fetched_at"/>
            </list>
        </field>
    </record>

    <record id="action_premafirm_geotab_driver" model="ir.actions.act_window">
        <field name="name">Geotab Driver Registry</field>
        <field name="res_model">premafirm.geotab.driver</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
