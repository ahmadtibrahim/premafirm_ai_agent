<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_premafirm_ai" model="ir.ui.view">
        <field name="name">account.move.form.premafirm.ai</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Header buttons -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_ai_generate_invoice"
                        string="AI Generate"
                        type="object"
                        class="btn-secondary"
                        icon="fa-magic"
                        invisible="move_type not in ('out_invoice','out_refund')"
                        help="Scan attached documents (BOL, packing slip, rate confirmation) to auto-fill the reference number, route description, and service product."/>
                <button name="action_delete_ai_chatter_notes"
                        string="Clean AI Notes"
                        type="object"
                        class="btn-secondary"
                        icon="fa-trash-o"
                        invisible="move_type not in ('out_invoice','out_refund')"
                        confirm="Remove auto-generated AI reference notes from the chatter? This cannot be undone."
                        help="Delete the auto-posted reference tracking messages created by AI Generate."/>
            </xpath>

            <!-- Smart buttons — estimator job_count kept hidden (used internally) -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="job_count" invisible="1"/>
            </xpath>

            <!-- Dispatch tab — Prema Dispatch only (content injected by prema_dispatch module) -->
            <xpath expr="//page[@id='other_tab']" position="after">
                <page string="Dispatch" name="dispatch_jobs_tab"
                      invisible="move_type not in ('out_invoice','out_refund')">
                </page>
            </xpath>

            <!-- WhatsApp / Text Input tab -->
            <xpath expr="//page[@id='other_tab']" position="before">
                <page string="Generate from Text" name="whatsapp_text_tab"
                      invisible="move_type not in ('out_invoice','out_refund')">
                    <group>
                        <field name="x_whatsapp_text"
                               widget="text"
                               nolabel="1"
                               placeholder="Paste a WhatsApp message, SMS, or email here…&#10;&#10;Example:&#10;Hi Ahmad, need pickup from Walmart Mississauga to Canadian Tire Brampton, 20 pallets, Thursday May 22. PO is 8847-B."
                               style="min-height:180px; font-size:13px;"/>
                    </group>
                    <div class="mt-2 d-flex align-items-center gap-3">
                        <button name="action_generate_from_whatsapp" type="object"
                                string="Generate Invoice Details"
                                class="btn btn-primary"
                                icon="fa-magic"/>
                        <small class="text-muted">
                            AI extracts reference numbers and builds the route description.
                            Looks at past 5 invoices for this customer to match their format.
                        </small>
                    </div>
                </page>
            </xpath>

            <!-- AI Summary section — shown on all invoice/bill types once a summary exists -->
            <xpath expr="//page[@id='other_tab']" position="before">
                <page string="AI Summary" name="ai_summary_tab"
                      invisible="not x_ai_summary and not x_ai_summary_instruction">
                    <group>
                        <field name="x_ai_summary" widget="text" nolabel="1"
                               readonly="1"
                               style="min-height:90px; background:#f0f4ff; border-left:3px solid #6c7dd1; padding:10px; border-radius:4px; white-space:pre-wrap;"/>
                    </group>
                    <group string="Refine this summary">
                        <field name="x_ai_summary_instruction"
                               placeholder="e.g. make shorter · explain fuel surcharge · remove cost info · customer-friendly version"/>
                        <div>
                            <button name="action_generate_ai_summary" type="object"
                                    string="Regenerate Summary"
                                    class="btn btn-secondary btn-sm"
                                    icon="fa-refresh"/>
                            <small class="text-muted ml-2"
                                   invisible="not x_ai_summary_at">
                                Last updated: <field name="x_ai_summary_at" widget="datetime" readonly="1"/>
                            </small>
                        </div>
                    </group>
                </page>
            </xpath>

            <!-- AI Summary button on vendor bills (AI Generate not available there) -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_generate_ai_summary"
                        string="AI Summary"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-text-o"
                        invisible="move_type not in ('in_invoice','in_refund')"
                        help="Generate a plain-English internal summary of this invoice — covers what was invoiced, the route/lane, and any pricing notes"/>
            </xpath>

            <!-- Auto-fill reference button -->
            <xpath expr="//group[@name='sale_info_group']/field[@name='ref']" position="after">
                <button name="action_ai_extract_reference" type="object"
                        string="⚡ Auto-fill from attachments or text"
                        class="btn btn-link btn-sm p-0 text-primary"
                        title="Scans attachments first. If none are attached, extracts from the text pasted in the 'Generate from Text' tab."
                        invisible="move_type not in ('out_invoice','out_refund')"/>
            </xpath>

            <!-- Hidden internal fields -->
            <xpath expr="//sheet/group" position="after">
                <field name="premafirm_po" invisible="1"/>
                <field name="premafirm_bol" invisible="1"/>
                <field name="premafirm_pod" invisible="1"/>
                <field name="load_reference" invisible="1"/>
                <field name="dispatch_estimator_id" invisible="1"/>
                <field name="job_count" invisible="1"/>
                <field name="x_ai_summary" invisible="1"/>
                <field name="x_ai_summary_instruction" invisible="1"/>
                <field name="x_ai_summary_at" invisible="1"/>
                <field name="x_whatsapp_text" invisible="1"/>
            </xpath>

            <!-- IFTA Province field — shown on vendor bills only -->
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="after">
                <group name="ifta_group" string="IFTA Fuel Reporting"
                       invisible="move_type != 'in_invoice'">
                    <field name="x_ifta_province"
                           string="Fuel Purchase Province / State"
                           placeholder="Select only for fuel bills…"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
