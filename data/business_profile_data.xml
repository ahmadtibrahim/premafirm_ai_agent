         DEFAULT BUSINESS PROFILE (singleton)
    ══════════════════════════════════════════════════════════════ -->
    <record id="default_business_profile" model="premafirm.business.profile">
        <field name="company_name">PremaFirm Inc.</field>
        <field name="tone_of_voice">professional</field>
        <!-- ICP: Industries -->
        <field name="icp_industry_ids" eval="[
            Command.link(ref('snov_ind_trucking')),
            Command.link(ref('snov_ind_logistics_supply_chain')),
            Command.link(ref('snov_ind_transportation_trucking_railroad')),
        ]"/>
        <!-- ICP: Seniority -->
        <field name="icp_seniority_ids" eval="[
            Command.link(ref('snov_seniority_clevel')),
            Command.link(ref('snov_seniority_vp')),
            Command.link(ref('snov_seniority_director')),
        ]"/>
        <!-- ICP: Regions -->
        <field name="icp_region_ids" eval="[
            Command.link(ref('snov_region_canada')),
            Command.link(ref('snov_region_usa')),
            Command.link(ref('snov_region_on')),
            Command.link(ref('snov_region_qc')),
            Command.link(ref('snov_region_ab')),
            Command.link(ref('snov_region_bc')),
        ]"/>
        <!-- ICP: Company Sizes -->
        <field name="icp_company_size_ids" eval="[
            Command.link(ref('snov_size_11_50')),
            Command.link(ref('snov_size_51_200')),
            Command.link(ref('snov_size_201_500')),
        ]"/>
        <!-- ICP: Job Titles -->
        <field name="icp_title_ids" eval="[
            Command.link(ref('snov_title_owner')),
            Command.link(ref('snov_title_president')),
            Command.link(ref('snov_title_ceo')),
            Command.link(ref('snov_title_ops_manager')),
            Command.link(ref('snov_title_logistics_manager')),
            Command.link(ref('snov_title_dispatch_manager')),
            Command.link(ref('snov_title_fleet_manager')),
            Command.link(ref('snov_title_freight_broker')),
            Command.link(ref('snov_title_broker')),
        ]"/>
    </record>

