<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- PHASES 18-19 — tag cleanup tooling + review filters. All
             records noupdate=1: names are config, never ids. Nothing
             here deletes. -->

        <!-- ── Review saved filters (mirror the search-bar facets) ───── -->
        <record id="ws_filter_dup_email" model="ir.filters">
            <field name="name">Duplicate Email (review)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="user_id" eval="0"/>
            <field name="domain">[('x_cleanup_dup_email','=',True)]</field>
            <field name="is_default" eval="False"/>
        </record>

        <record id="ws_filter_re_fwd" model="ir.filters">
            <field name="name">RE:/FWD: Subject (review)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="user_id" eval="0"/>
            <field name="domain">[('x_cleanup_re_fwd','=',True)]</field>
            <field name="is_default" eval="False"/>
        </record>

        <!-- ── Tag cleanup: DRY-RUN only server action (safe by default)
             Applying the merge happens in the 18.0.6.17.0 migration; this
             action only reports what WOULD happen. Bound to the CRM Tag
             menu (sales_team). -->
        <record id="action_tag_cleanup_dry_run" model="ir.actions.server">
            <field name="name">Tag Cleanup — Dry Run (report only)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="sales_team.model_crm_tag"/>
            <field name="state">code</field>
            <field name="code">summary = env['crm.tag'].run_tag_cleanup(
    dry_run=True, source='manual')
lines = ['Tag cleanup DRY RUN — no changes made:']
for canonical, info in sorted(summary.items()):
    lines.append('  %s → create=%s, leads to move=%s, archive=%s' % (
        canonical, info['created'], info['leads'],
        ', '.join(info['archived']) or '—'))
raise UserError('\n'.join(lines))</field>
        </record>
    </data>
</odoo>
