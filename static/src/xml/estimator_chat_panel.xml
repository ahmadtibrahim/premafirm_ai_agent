<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="premafirm_ai_engine.EstimatorChatPanel"
       owl="1">

        <li class="o_premafirm_est_root">
            <a href="#" class="o_premafirm_est_launcher"
               title="Prema Estimator — unified itinerary, 3 scenarios, pricing intel"
               t-on-click.prevent="togglePanel">
                <i class="fa fa-truck-moving"/>
                <span class="o_premafirm_est_launcher_label">Estimator</span>
            </a>

            <t t-if="state.panelOpen">
                <div class="o_premafirm_est_backdrop"
                     t-on-click="togglePanel"/>
                <div class="o_premafirm_est_panel">

                    <div class="o_premafirm_est_header">
                        <span class="o_premafirm_est_title">Prema Estimator</span>
                        <span class="o_premafirm_est_subtitle">unified itinerary · 3 scenarios · pricing intel</span>
                        <button type="button" class="btn btn-sm btn-light ms-auto"
                                t-on-click="togglePanel" title="Close">
                            <i class="fa fa-times"/>
                        </button>
                    </div>

                    <div class="o_premafirm_est_body">

                        <!-- Truck -->
                        <div class="o_est_field_row">
                            <label class="o_est_field_label">Truck</label>
                            <select class="form-select"
                                    t-att-value="state.vehicleId"
                                    t-on-change="onVehicleChange">
                                <option value="">Select truck…</option>
                                <t t-foreach="state.vehicles" t-as="v" t-key="v.id">
                                    <option t-att-value="v.id">
                                        <t t-esc="v.name"/>
                                        <t t-if="v.x_reefer"> (Reefer)</t>
                                        <t t-if="!v.x_operational_logistics"> (not operational)</t>
                                    </option>
                                </t>
                            </select>
                            <div class="o_est_hint"
                                 t-if="state.vehicleReefer">Reefer truck — temperature-controlled scenario will be offered.</div>
                        </div>

                        <!-- Customer — single searchable combobox (name /
                             email / phone).  "No customer selected (new
                             enquiry)" is the cleared state (hint below); the
                             matching partner_id rides on the estimate →
                             pricing intel + draft rate confirmation. -->
                        <div class="o_est_field_row">
                            <label class="o_est_field_label">Customer <span class="o_est_muted">(optional — search name, email or phone)</span></label>
                            <div class="o_est_customer_wrap o_est_combobox">
                                <div class="o_est_cb_ctrl">
                                    <input type="text"
                                           class="form-control o_est_customer_search"
                                           placeholder="Start typing to search existing customers…"
                                           autocomplete="off" spellcheck="false"
                                           role="combobox"
                                           t-att-aria-expanded="state.customerOpen ? 'true' : 'false'"
                                           t-att-value="state.customerTerm"
                                           t-ref="customerInput"
                                           t-on-input="onCustomerInput"
                                           t-on-focus="onCustomerFocus"
                                           t-on-keydown="onCustomerKeydown"
                                           t-on-blur="onCustomerBlur"/>
                                    <span class="o_est_cb_affix">
                                        <i class="fa fa-spinner fa-spin"
                                           t-if="state.customerBusy"/>
                                        <button type="button"
                                                class="o_est_cb_clear"
                                                title="Clear customer selection (new enquiry)"
                                                t-if="state.customerId"
                                                t-on-click="clearCustomer">×</button>
                                    </span>
                                </div>
                                <ul class="o_est_cb_menu" t-if="state.customerOpen"
                                    role="listbox">
                                    <li class="o_est_cb_item o_est_cb_hint"
                                        t-if="!state.customerOptions.length">
                                        <t t-if="state.customerTerm.trim().length >= 2">No matching customer — the estimate stays a <b>new enquiry</b> (you can still link a customer later).</t>
                                        <t t-else="">Type at least 2 letters, an email or a phone number…</t>
                                    </li>
                                    <t t-foreach="state.customerOptions" t-as="c" t-key="c.id">
                                        <li t-att-class="'o_est_cb_item' + (state.customerActiveIndex === c_index ? ' active' : '')"
                                            role="option"
                                            t-att-aria-selected="state.customerActiveIndex === c_index"
                                            t-on-mousedown.prevent="() => this.onCustomerPick(c_index)"
                                            t-on-mouseenter="() => this.onCustomerHover(c_index)">
                                            <span class="o_est_cb_name"><t t-esc="c.name"/></span>
                                            <span class="o_est_cb_sub">
                                                <t t-if="c.email">✉ <t t-esc="c.email"/></t>
                                                <t t-if="c.phone"> · ☏ <t t-esc="c.phone"/></t>
                                                <t t-if="c.city"> · <t t-esc="c.city"/></t>
                                            </span>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                            <div class="o_est_hint o_est_cb_picked"
                                 t-if="state.customerId">
                                <i class="fa fa-user-check me-1"/>
                                <b t-esc="state.customerLabel"/> — pricing intel &amp; the draft rate confirmation will be linked to this customer.
                            </div>
                            <div class="o_est_hint o_est_cb_emptyhint" t-else="">
                                No customer selected (new enquiry)
                            </div>
                        </div>

                        <!-- When -->
                        <div class="o_est_field_row o_est_fields_inline">
                            <div>
                                <label class="o_est_field_label">Pickup date</label>
                                <input type="date" class="form-control"
                                       t-att-value="state.pickupDate"
                                       t-on-change="onPickupDateChange"/>
                            </div>
                            <div>
                                <label class="o_est_field_label">Return home</label>
                                <div class="form-check o_est_switch">
                                    <input type="checkbox" class="form-check-input"
                                           id="est_return_home"
                                           t-att-checked="state.returnHome"
                                           t-on-change="onReturnHomeChange"/>
                                    <label class="form-check-label" for="est_return_home">
                                        Empty return to truck base after last drop
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Structured stops (MP2) — review controls
                             populated by extraction, editable, the
                             authoritative source for routing/pricing -->
                        <div class="o_est_field_row o_est_stops">
                            <div class="o_est_stops_head">
                                <label class="o_est_field_label">Stops
                                    <span class="o_est_muted">(auto-filled from the request — review before booking)</span>
                                </label>
                                <div class="o_est_stops_actions">
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            t-on-click="() => this.addStop('pickup')">
                                        <i class="fa fa-plus"/> Add Pickup
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            t-on-click="() => this.addStop('delivery')">
                                        <i class="fa fa-plus"/> Add Delivery
                                    </button>
                                </div>
                            </div>
                            <div class="o_est_stops_empty" t-if="!state.stops.length">
                                No structured stops yet — they appear here after you click
                                <b>Estimate scenarios</b>, or add them manually.
                            </div>
                            <t t-foreach="state.stops" t-as="stop" t-key="stop_index">
                                <div class="o_est_stop_card"
                                     t-att-class="'o_est_stop_card ' + (stop.status || 'incomplete')">
                                    <div class="o_est_stop_head">
                                        <span class="o_est_stop_type"
                                              t-att-class="'o_est_stop_type ' + stop.stop_type">
                                            <t t-if="stop.stop_type === 'pickup'">📦 Pickup</t>
                                            <t t-else="">📍 Delivery</t>
                                        </span>
                                        <span class="o_est_stop_status"
                                              t-att-class="'o_est_stop_status st-' + (stop.status || 'incomplete')">
                                            <t t-if="stop.status === 'saved_reused'">Reused Saved Location</t>
                                            <t t-elif="stop.status === 'manual'">Manual Address</t>
                                            <t t-elif="stop.status === 'new_pending'">New Location — Pending Review</t>
                                            <t t-elif="stop.status === 'incomplete'">Incomplete Address — Not Saved</t>
                                            <t t-else=""><t t-esc="stop.status"/></t>
                                        </span>
                                        <div class="o_est_stop_tools ms-auto">
                                            <button type="button" class="btn btn-sm btn-light"
                                                    title="Move up"
                                                    t-on-click="() => this.moveStop(stop_index, -1)">▲</button>
                                            <button type="button" class="btn btn-sm btn-light"
                                                    title="Move down"
                                                    t-on-click="() => this.moveStop(stop_index, 1)">▼</button>
                                            <button type="button" class="btn btn-sm btn-light"
                                                    title="Remove stop"
                                                    t-on-click="() => this.removeStop(stop_index)">✕</button>
                                        </div>
                                    </div>

                                    <div class="o_est_stop_body">
                                        <!-- Saved Location combobox -->
                                        <div class="o_est_cb_ctrl">
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Search Saved Locations…"
                                                   autocomplete="off"
                                                   t-att-value="stop.locTerm"
                                                   t-on-input="(ev) => this.onStopLocInput(stop_index, ev)"/>
                                            <span class="o_est_cb_affix">
                                                <button type="button" class="o_est_cb_clear"
                                                        title="Clear location link"
                                                        t-if="stop.saved_location_id"
                                                        t-on-click="() => this.clearStopLocation(stop_index)">×</button>
                                            </span>
                                        </div>
                                        <ul class="o_est_cb_menu o_est_stop_loc_menu"
                                            t-if="stop.locOpen" role="listbox">
                                            <li class="o_est_cb_item o_est_cb_hint"
                                                t-if="!stop.locOptions.length">No matching Saved Locations — enter the address manually.</li>
                                            <t t-foreach="stop.locOptions" t-as="loc" t-key="loc.id">
                                                <li class="o_est_cb_item" role="option"
                                                    t-on-mousedown.prevent="() => this.pickStopLocation(stop_index, loc)">
                                                    <span class="o_est_cb_name"><t t-esc="loc.name"/></span>
                                                    <span class="o_est_cb_sub"><t t-esc="loc.address"/></span>
                                                </li>
                                            </t>
                                        </ul>

                                        <!-- Manual address -->
                                        <div class="o_est_stop_grid">
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Company"
                                                   t-att-value="stop.company_name"
                                                   t-on-input="(ev) => this.updateStop(stop_index, 'company_name', ev.target.value)"/>
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Address (street)"
                                                   t-att-value="stop.address"
                                                   t-on-input="(ev) => this.updateStop(stop_index, 'address', ev.target.value)"/>
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="City"
                                                   t-att-value="stop.city"
                                                   t-on-input="(ev) => this.updateStop(stop_index, 'city', ev.target.value)"/>
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Province"
                                                   t-att-value="stop.province"
                                                   t-on-input="(ev) => this.updateStop(stop_index, 'province', ev.target.value)"/>
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Postal"
                                                   t-att-value="stop.postal_code"
                                                   t-on-input="(ev) => this.updateStop(stop_index, 'postal_code', ev.target.value)"/>
                                        </div>

                                        <!-- Quantity / timing / instructions
                                             (§7: permanent visible labels +
                                             units — never placeholder-only) -->
                                        <div class="o_est_stop_grid o_est_stop_grid_qty">
                                            <label class="o_est_stop_lbl">Pallets (positions)
                                                <input type="number" min="0" class="form-control form-control-sm"
                                                       t-att-value="stop.pallets"
                                                       t-on-input="(ev) => this.updateStop(stop_index, 'pallets', ev.target.value)"/>
                                            </label>
                                            <label class="o_est_stop_lbl">Loose cases (boxes)
                                                <input type="number" min="0" class="form-control form-control-sm"
                                                       t-att-value="stop.cases"
                                                       t-on-input="(ev) => this.updateStop(stop_index, 'cases', ev.target.value)"/>
                                            </label>
                                            <label class="o_est_stop_lbl">Weight (lbs)
                                                <input type="number" min="0" step="1" class="form-control form-control-sm"
                                                       t-att-value="stop.weight_lbs"
                                                       t-on-input="(ev) => this.updateStop(stop_index, 'weight_lbs', ev.target.value)"/>
                                            </label>
                                            <label class="o_est_stop_lbl">Requested date
                                                <input type="date" class="form-control form-control-sm"
                                                       t-att-value="stop.stop_date"
                                                       t-on-change="(ev) => this.updateStop(stop_index, 'stop_date', ev.target.value)"/>
                                            </label>
                                            <label class="o_est_stop_lbl">Appointment
                                                <select class="form-select form-select-sm"
                                                        t-att-value="stop.time_window_type"
                                                        t-on-change="(ev) => this.updateStop(stop_index, 'time_window_type', ev.target.value)">
                                                    <option value="any">Anytime</option>
                                                    <option value="exact">Exact time</option>
                                                    <option value="window">Time window</option>
                                                </select>
                                            </label>
                                            <label class="o_est_stop_lbl"
                                                   t-if="stop.time_window_type === 'exact'">Exact time
                                                <input type="time" class="form-control form-control-sm"
                                                       t-att-value="fmtHour(stop.exact_time)"
                                                       t-on-change="(ev) => this.updateStop(stop_index, 'exact_time', this.parseHour(ev.target.value))"/>
                                            </label>
                                            <label class="o_est_stop_lbl"
                                                   t-if="stop.time_window_type === 'window'">Window start
                                                <input type="time" class="form-control form-control-sm"
                                                       t-att-value="fmtHour(stop.window_start)"
                                                       t-on-change="(ev) => this.updateStop(stop_index, 'window_start', this.parseHour(ev.target.value))"/>
                                            </label>
                                            <label class="o_est_stop_lbl"
                                                   t-if="stop.time_window_type === 'window'">Window end
                                                <input type="time" class="form-control form-control-sm"
                                                       t-att-value="fmtHour(stop.window_end)"
                                                       t-on-change="(ev) => this.updateStop(stop_index, 'window_end', this.parseHour(ev.target.value))"/>
                                            </label>
                                        </div>
                                        <input type="text" class="form-control form-control-sm"
                                               placeholder="Special instructions"
                                               t-att-value="stop.instructions"
                                               t-on-input="(ev) => this.updateStop(stop_index, 'instructions', ev.target.value)"/>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Extracted-change conflicts (reviewed stops are
                             never silently replaced) -->
                        <div class="o_est_conflict_banner" t-if="state.conflicts.length">
                            <div class="o_est_banner banner-error">
                                <b>The customer text changed for reviewed stops.</b>
                                Apply the detected changes or keep your reviewed stops.
                            </div>
                            <div class="o_est_stop_conflict"
                                 t-foreach="state.conflicts" t-as="cf" t-key="cf_index">
                                <span class="o_est_stop_type"
                                      t-att-class="'o_est_stop_type ' + cf.stop_type">
                                    <t t-if="cf.stop_type === 'pickup'">📦 Pickup</t>
                                    <t t-else="">📍 Delivery</t>
                                </span>
                                <span class="o_est_conflict_cur">
                                    reviewed: <t t-esc="cf.current.company_name || cf.current.address"/> ·
                                    <t t-esc="cf.current.pallets"/> plt
                                </span>
                                <span> → </span>
                                <span class="o_est_conflict_new">
                                    text: <t t-esc="cf.proposed.company_name || cf.proposed.address"/> ·
                                    <t t-esc="cf.proposed.pallets"/> plt
                                </span>
                            </div>
                            <div class="o_est_stops_actions">
                                <button type="button" class="btn btn-sm btn-primary"
                                        t-on-click="acceptStopChanges">
                                    <i class="fa fa-check"/> Apply detected changes
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        t-on-click="keepReviewedStops">
                                    Keep reviewed stops
                                </button>
                            </div>
                        </div>

                        <!-- Request -->
                        <div class="o_est_field_row">
                            <label class="o_est_field_label">Customer request <span class="o_est_muted">(email / chat / call notes)</span></label>
                            <textarea class="form-control o_est_chat_text" rows="4"
                                      placeholder="e.g. 12 pallets reefer from Toronto (M5V) to Montreal (H4N), 3 delivery stops — what would it cost and when can it go?"
                                      t-att-value="state.chatText"
                                      t-on-input="onChatInput"/>
                        </div>

                        <!-- Attachments -->
                        <div class="o_est_field_row">
                            <div class="o_premafirm_est_dropzone"
                                 t-att-class="state.dragOver ? 'drag-over' : ''"
                                 t-on-click="onDropzoneClick"
                                 t-on-dragover.prevent="onDragOver"
                                 t-on-dragleave="onDragLeave"
                                 t-on-drop.prevent="onFilesDrop">
                                <i class="fa fa-cloud-upload-alt"/>
                                <span>Drop PDF / JPG / PNG / WebP here or click to browse</span>
                                <input type="file" class="d-none" multiple="multiple"
                                       accept="application/pdf,image/jpeg,image/png,image/webp"
                                       t-ref="fileInput"
                                       t-on-change="onFilesChange"/>
                            </div>
                            <div class="o_est_chips" t-if="state.files.length">
                                <t t-foreach="state.files" t-as="f" t-key="f_index">
                                    <span class="o_est_chip chip-file">
                                        <i class="fa fa-paperclip"/>
                                        <span t-esc="f.name"/>
                                        <span class="o_est_muted" t-esc="formatFileSize(f.size)"/>
                                        <button type="button"
                                                class="btn btn-sm o_est_chip_x"
                                                t-att-data-index="f_index"
                                                t-on-click="onRemoveFileClick"
                                                title="Remove file">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </span>
                                </t>
                            </div>
                        </div>

                        <!-- Options -->
                        <div class="o_est_options">
                            <label class="o_est_check">
                                <input type="checkbox" class="form-check-input"
                                       t-att-checked="state.avoidTolls"
                                       t-on-change="onAvoidTollsChange"/>
                                Avoid tolls
                            </label>
                            <label class="o_est_check">
                                <input type="checkbox" class="form-check-input"
                                       t-att-checked="state.allowUSA"
                                       t-on-change="onAllowUSAChange"/>
                                Allow cross-border (US)
                            </label>
                        </div>

                        <!-- Submit -->
                        <button type="button"
                                class="btn btn-primary o_premafirm_est_submit"
                                t-att-disabled="state.loading ? true : false"
                                t-on-click="onSubmit">
                            <i class="fa fa-spinner fa-spin" t-if="state.loading"/>
                            <i class="fa fa-magnifying-glass-location" t-else=""/>
                            <t t-if="state.loading">Analyzing with dispatch authority…</t>
                            <t t-else="">Estimate scenarios</t>
                        </button>

                        <div class="o_premafirm_est_error alert alert-danger"
                             t-if="state.error" role="alert">
                            <i class="fa fa-circle-exclamation me-1"/>
                            <t t-esc="state.error"/>
                        </div>

                        <div class="o_premafirm_est_result_wrap" t-if="state.resultHtml">
                            <div class="o_premafirm_est_result_body"
                                 t-on-click="onResultClick"
                                 t-out="resultMarkup"/>
                        </div>

                        <!-- §1 manual road-distance override — appears
                             ONLY when a direct scenario could not be
                             routed (estimate unavailable): correcting the
                             stop addresses in the stop list above is the
                             first option; this is the explicit override
                             with an approximate road distance. -->
                        <div class="o_est_field_row o_est_fields_inline o_est_manual_route"
                             t-if="state.result and state.result.ok and needsManualOverride">
                            <div class="o_est_manual_hint">
                                Stops could not be routed between each other
                                — correct the stop addresses above, or
                                override with an approximate road distance:
                            </div>
                            <div>
                                <label class="o_est_field_label">Road distance (km) *</label>
                                <input type="number" class="form-control"
                                       min="0" step="1"
                                       placeholder="e.g. 412"
                                       t-att-value="state.manualKm"
                                       t-on-change="onManualKmChange"/>
                            </div>
                            <div>
                                <label class="o_est_field_label">Drive time (h) — optional</label>
                                <input type="number" class="form-control"
                                       min="0" step="0.5"
                                       placeholder="auto ≈ km ÷ 70 km/h"
                                       t-att-value="state.manualHrs"
                                       t-on-change="onManualHrsChange"/>
                            </div>
                            <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    title="Re-run the estimate using this road distance"
                                    t-on-click="applyManualRoute">
                                Apply manual distance
                            </button>
                        </div>

                        <!-- Margin control — adjust before choosing a
                             selling price.  Re-prices the scenarios with
                             the entered markup-on-cost (the server is the
                             pricing authority; this re-runs the estimate
                             with the override). -->
                        <div class="o_est_field_row o_est_fields_inline"
                             t-if="state.result and state.result.ok">
                            <div>
                                <label class="o_est_field_label">Margin — markup on cost</label>
                                <input type="number" class="form-control"
                                       min="0" max="500" step="1"
                                       placeholder="Server default"
                                       t-att-value="state.marginPct"
                                       t-on-change="onMarginChange"/>
                            </div>
                            <button type="button"
                                    class="btn btn-secondary btn-sm o_est_margin_apply"
                                    t-att-disabled="state.loading ? true : false"
                                    t-on-click="applyMargin">
                                <i class="fa fa-spinner fa-spin" t-if="state.loading"/>
                                <t t-if="state.loading">Re-pricing…</t>
                                <t t-else="">Apply margin</t>
                            </button>
                        </div>

                    </div>

                    <div class="o_premafirm_est_footer" t-if="state.result">
                        <!-- §10 quote → approval → booking chain -->
                        <div class="o_est_workflow" t-if="state.quoteWorkflow.length">
                            <div class="o_est_alt_title">
                                <t t-esc="state.quoteName"/>
                                <button type="button" class="btn btn-sm btn-light ms-1"
                                        title="Refresh quote status"
                                        t-on-click="refreshQuoteWorkflow">↻</button>
                            </div>
                            <t t-foreach="state.quoteWorkflow" t-as="wf" t-key="wf.step">
                                <span t-att-class="'o_est_wf_step ' + (wf.done ? 'done' : (wf.available ? 'ready' : 'locked'))">
                                    <t t-if="wf.done">✔</t>
                                    <t t-elif="wf.available">▶</t>
                                    <t t-else="">🔒</t>
                                    <t t-esc="wf.label"/>
                                </span>
                            </t>
                        </div>
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                title="Route Development — this week's corridor schedule for the truck and the request's region pair"
                                t-if="state.result.ok"
                                t-att-disabled="state.routeDevBusy ? true : false"
                                t-on-click="onRouteDev">
                            <i class="fa fa-calendar-week"/>
                            <t t-if="state.routeDevBusy">Loading…</t>
                            <t t-else="">Route development</t>
                        </button>
                        <button type="button"
                                class="btn btn-success btn-sm"
                                title="Create ONE editable DRAFT rate confirmation on the customer's lead — nothing is sent or confirmed"
                                t-if="canDraftRC"
                                t-on-click="onCreateDraftRC">
                            <i class="fa fa-file-signature"/>
                            Create Draft Rate Confirmation
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                title="Open the request audit record"
                                t-on-click="openRecord">
                            <i class="fa fa-folder-open"/>
                            Request record
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm ms-auto"
                                title="Start a new estimate"
                                t-on-click="resetPanel">
                            <i class="fa fa-rotate-left"/>
                            New estimate
                        </button>
                    </div>

                </div>
            </t>
        </li>
    </t>
</templates>
