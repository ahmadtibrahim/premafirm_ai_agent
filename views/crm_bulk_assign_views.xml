<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Wizard view -->
    <record id="view_crm_bulk_assign_wizard" model="ir.ui.view">
        <field name="name">crm.bulk.assign.wizard.form</field>
        <field name="model">crm.bulk.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Salesperson">
                <sheet>
                    <group>
                        <field name="user_id" autofocus="1"/>
                        <field name="lead_count" string="Leads Selected" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_assign" type="object"
                            string="Assign" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server action bound to crm.lead — appears in Action menu -->
    <record id="action_crm_bulk_assign" model="ir.actions.server">
        <field name="name">Assign Salesperson</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Assign Salesperson',
    'res_model': 'crm.bulk.assign.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'active_ids': records.ids},
}
        </field>
    </record>

</odoo>
