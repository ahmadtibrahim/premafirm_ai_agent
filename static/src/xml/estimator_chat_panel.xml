<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="premafirm_ai_engine.EstimatorChatPanel">

        <!-- ── Systray trigger button ───────────────────────────────── -->
        <li class="o_nav_entry d-flex align-items-center">
            <button class="o_premafirm_est_btn" t-on-click="togglePanel" title="Open Trip Cost Estimator">
                <i class="fa fa-calculator"/>
                <span>Estimator</span>
            </button>
        </li>

        <!-- ── Backdrop + panel (shown when open) ───────────────────── -->
        <t t-if="state.panelOpen">

            <div class="o_premafirm_est_backdrop" t-on-click="togglePanel"/>

            <div class="o_premafirm_est_panel">

                <!-- Header -->
                <div class="o_premafirm_est_header">
                    <h5>
                        <i class="fa fa-calculator text-warning me-2"/>
                        Trip Cost Estimator
                    </h5>
                    <button class="btn-close" aria-label="Close" t-on-click="togglePanel"/>
                </div>

                <!-- Scrollable body -->
                <div class="o_premafirm_est_body">

                    <!-- Mode toggle -->
                    <div class="o_premafirm_est_mode mb-3">
                        <button t-att-class="state.mode === 'chat' ? 'active' : ''"
                                t-on-click="() => this.setMode('chat')">
                            <i class="fa fa-comment me-1"/>Chat / Text
                        </button>
                        <button t-att-class="state.mode === 'files' ? 'active' : ''"
                                t-on-click="() => this.setMode('files')">
                            <i class="fa fa-files-o me-1"/>Upload Files
                        </button>
                    </div>

                    <!-- Truck selector -->
                    <div class="mb-3">
                        <label><i class="fa fa-truck me-1"/>Truck</label>
                        <select class="form-select form-select-sm"
                                t-on-change="onVehicleChange">
                            <option value="">— Select Truck —</option>
                            <t t-foreach="state.vehicles" t-as="v" t-key="v.id">
                                <option t-att-value="v.id"
                                        t-att-selected="state.vehicleId === v.id"
                                        t-esc="v.name"/>
                            </t>
                        </select>
                    </div>

                    <!-- ── CHAT MODE ─────────────────────────────────── -->
                    <t t-if="state.mode === 'chat'">
                        <div class="mb-2">
                            <label><i class="fa fa-comment me-1"/>Rate Request Message</label>
                            <textarea class="form-control form-control-sm"
                                      rows="9"
                                      placeholder="Paste your WhatsApp message, email, or type the rate request here...&#10;&#10;Example:&#10;Tomorrow's Run&#10;Pickup orders at 115 Chambers Drive, Ajax ON&#10;Deliver order to Sal's grocery&#10;Pickup 1 pallet for F4L Lindsay at Grandview Discount Foods&#10;Deliver 7 pallets total to: F4L Lindsay, 62 Riverview Road, Lindsay ON&#10;Deliver 2 pallets to: Sharpes Warehouse, 34 Tanner Industrial Park, Campbellford ON&#10;Deliver 1 pallet to: Nofrills Belleville, 211 Bell Blvd, Belleville ON"
                                      t-att-value="state.chatText"
                                      t-on-input="onChatInput"/>
                        </div>
                    </t>

                    <!-- ── FILES MODE ────────────────────────────────── -->
                    <t t-if="state.mode === 'files'">
                        <div class="mb-2">
                            <label><i class="fa fa-file-pdf-o me-1"/>Bill of Lading / Route Sheet</label>
                            <!-- Drop zone -->
                            <div class="o_premafirm_est_dropzone"
                                 t-att-class="state.dragOver ? 'drag-over' : ''"
                                 t-on-drop="onFilesDrop"
                                 t-on-dragover="onDragOver"
                                 t-on-dragleave="onDragLeave"
                                 t-on-click="onDropzoneClick">
                                <i class="fa fa-cloud-upload dz-icon"/>
                                <p>Drop PDFs or images here</p>
                                <p class="dz-hint">or click to browse &nbsp;·&nbsp; Multiple files supported</p>
                            </div>
                            <!-- Hidden file input -->
                            <input t-ref="fileInput"
                                   type="file"
                                   class="d-none"
                                   accept=".pdf,.jpg,.jpeg,.png,.webp"
                                   multiple="multiple"
                                   t-on-change="onFilesChange"/>

                            <!-- File chips -->
                            <div t-if="state.files.length > 0" class="o_premafirm_est_file_list">
                                <t t-foreach="state.files" t-as="file" t-key="file_index">
                                    <div class="o_premafirm_est_file_chip">
                                        <i class="fa fa-file-pdf-o text-danger"/>
                                        <span class="fc-name" t-esc="file.name"/>
                                        <span class="fc-size" t-esc="formatFileSize(file.size)"/>
                                        <button class="fc-remove"
                                                t-att-data-index="file_index"
                                                t-on-click="onRemoveFileClick"
                                                title="Remove">×</button>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- Options -->
                    <div class="o_premafirm_est_options">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="est_avoid_tolls"
                                   t-att-checked="state.avoidTolls"
                                   t-on-change="onAvoidTollsChange"/>
                            <label class="form-check-label" for="est_avoid_tolls">Avoid Tolls</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="est_allow_usa"
                                   t-att-checked="state.allowUSA"
                                   t-on-change="onAllowUSAChange"/>
                            <label class="form-check-label" for="est_allow_usa">Allow USA Routing</label>
                        </div>
                    </div>

                    <!-- Submit -->
                    <button class="o_premafirm_est_submit"
                            t-att-disabled="state.loading || undefined"
                            t-on-click="onSubmit">
                        <t t-if="state.loading">
                            <span class="spinner-border spinner-border-sm"/>
                            Calculating…
                        </t>
                        <t t-else="">
                            <i class="fa fa-calculator"/>
                            Calculate Estimate
                        </t>
                    </button>

                    <!-- Error -->
                    <div t-if="state.error" class="o_premafirm_est_error">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <t t-esc="state.error"/>
                    </div>

                    <!-- Results -->
                    <div t-if="state.result" class="o_premafirm_est_result">
                        <div class="o_premafirm_est_result_body">
                            <t t-out="resultMarkup"/>
                        </div>
                        <div class="o_premafirm_est_result_footer">
                            <button class="btn btn-sm btn-outline-primary"
                                    t-on-click="openRecord">
                                <i class="fa fa-external-link me-1"/>Open Full Estimate
                            </button>
                            <button class="btn btn-sm btn-outline-secondary"
                                    t-on-click="resetPanel">
                                <i class="fa fa-refresh me-1"/>New Estimate
                            </button>
                        </div>
                    </div>

                </div><!-- /body -->
            </div><!-- /panel -->

        </t>
    </t>

</templates>
