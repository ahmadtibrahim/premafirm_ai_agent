<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Server action: set stage to OUTREACH SENT (canonical) ─────── -->
        <!-- Resolves the canonical stage by XMLID first (never by name —
             the legacy folded "Outreach" stage still exists and a name
             search would move leads INTO the archived stage). -->
        <record id="action_server_new_to_outreach" model="ir.actions.server">
            <field name="name">CRM: Set Stage → OUTREACH SENT</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">
stage = env.ref('premafirm_ai_engine.crm_stage_outreach_sent', raise_if_not_found=False)
if not stage:
    stage = env['crm.stage'].search(
        [('name', '=ilike', 'outreach sent'), ('fold', '=', False)], limit=1)
if stage:
    record.write({'stage_id': stage.id})
            </field>
        </record>

        <!-- ── Automated action: NEW / UNCONTACTED → OUTREACH SENT when contact details complete ── -->
        <!-- Issue 13: DISABLED.  Contact completeness never means outreach
             was sent — this on_write rule (no watched field) moved any
             complete-details lead on ANY ordinary edit.  The stage now
             advances only from a genuine outbound customer email posted on
             the lead (crm_reply_status._message_post_after_hook).  The
             existing DB record is deactivated by the 18.0.7.7.0 migration
             (noupdate="1" cannot flip it on upgraded databases). -->
        <record id="automation_new_to_outreach" model="base.automation">
            <field name="name">CRM: NEW / UNCONTACTED → OUTREACH SENT (contact details complete)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="trigger">on_write</field>
            <field name="active" eval="False"/>
            <!-- Filter: must be in NEW / UNCONTACTED, have a tag, have an email, and contact must be under a company -->
            <field name="filter_domain">[('stage_id.name', '=', 'NEW / UNCONTACTED'), ('tag_ids', '!=', False), ('email_from', '!=', False), ('partner_id', '!=', False), ('partner_id.parent_id', '!=', False)]</field>
            <field name="action_server_ids" eval="[(4, ref('action_server_new_to_outreach'))]"/>
        </record>

        <!-- ── Cron: Outreach/Contacted no reply → Data Collection ─────────── -->
        <record id="ir_cron_outreach_stale" model="ir.cron">
            <field name="name">CRM: Outreach/Contacted — No Reply → Data Collection</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model.run_outreach_stale_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
            <field name="nextcall">2026-05-18 08:00:00</field>
        </record>

        <!-- ── Cron: Replied +3 days → warning activity ───────────────────── -->
        <record id="ir_cron_replied_warning" model="ir.cron">
            <field name="name">CRM: Replied Stage — 3-Day Follow-up Warning</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model.run_replied_warning_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
            <field name="nextcall">2026-05-14 08:00:00</field>
        </record>

        <!-- ── Cron: Replied +6 days → move to Data Collection ───────────── -->
        <record id="ir_cron_replied_stale" model="ir.cron">
            <field name="name">CRM: Replied Stage — 6-Day Stale → Data Collection</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model.run_replied_stale_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
            <field name="nextcall">2026-05-14 08:00:00</field>
        </record>

    </data>
</odoo>
